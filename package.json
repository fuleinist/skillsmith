{
  "name": "skillsmith",
  "version": "0.1.0",
  "description": "Toolkit for agent skills: scaffold, lint, test, and pack SKILL.md packages for Claude Code, Codex, and Cursor.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skillsmith": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "skill-md",
    "claude-code",
    "codex",
    "cursor",
    "cli",
    "lint"
  ],
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuleinist/skillsmith.git"
  }
}